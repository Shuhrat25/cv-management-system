datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CANDIDATE") // CANDIDATE, RECRUITER, ADMIN
  location     String?  @default("Tashkent, Uzbekistan")
  avatarUrl    String?
  isBlocked    Boolean  @default(false)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attributeValues CandidateAttributeValue[]
  projects        CandidateProject[]
  positions       Position[]                @relation("RecruiterPositions")
  cvs             CV[]                      @relation("CandidateCVs")
  likes           CVLike[]
  discussions     PositionDiscussion[]
}

model AttributeCategory {
  id         String      @id @default(uuid())
  name       String      @unique
  attributes Attribute[]
}

model Attribute {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  dataType    String // STRING, TEXT, IMAGE, NUMERIC, DATE, PERIOD, BOOLEAN, ONE_OF_MANY
  optionsJson String? // JSON string array for ONE_OF_MANY
  version     Int               @default(1)
  categoryId  String
  category    AttributeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  values        CandidateAttributeValue[]
  positionAttrs PositionAttribute[]
}

model CandidateAttributeValue {
  id          String    @id @default(uuid())
  candidateId String
  candidate   User      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, attributeId])
}

model CandidateProject {
  id          String   @id @default(uuid())
  candidateId String
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  startDate   String
  endDate     String?
  description String
  tagsJson    String   @default("[]")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Position {
  id              String   @id @default(uuid())
  title           String
  description     String
  isPublic        Boolean  @default(true)
  accessRulesJson String   @default("[]")
  projectTagsJson String   @default("[]")
  maxProjects     Int      @default(3)
  apiToken        String   @unique @default(uuid())
  version         Int      @default(1)
  createdById     String
  createdBy       User     @relation("RecruiterPositions", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attributes  PositionAttribute[]
  cvs         CV[]
  discussions PositionDiscussion[]
}

model PositionAttribute {
  id          String    @id @default(uuid())
  positionId  String
  position    Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isRequired  Boolean   @default(true)
  order       Int       @default(0)

  @@unique([positionId, attributeId])
}

model CV {
  id          String   @id @default(uuid())
  candidateId String
  candidate   User     @relation("CandidateCVs", fields: [candidateId], references: [id], onDelete: Cascade)
  positionId  String
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  isPublished Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes CVLike[]

  @@unique([candidateId, positionId])
}

model CVLike {
  id          String   @id @default(uuid())
  cvId        String
  cv          CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  recruiterId String
  recruiter   User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([cvId, recruiterId])
}

model PositionDiscussion {
  id         String   @id @default(uuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
}
